{"id":9164,"date":"2020-11-18T00:00:00","date_gmt":"2020-11-18T07:00:00","guid":{"rendered":"https:\/\/www.rethinkfirst.com\/resources\/electronic-visit-verification-evv-for-billing-florida-medicaid-webinar\/"},"modified":"2024-10-07T11:42:41","modified_gmt":"2024-10-07T15:42:41","slug":"electronic-visit-verification-evv-for-billing-florida-medicaid-webinar","status":"publish","type":"resources","link":"https:\/\/www.rethinkbehavioralhealth.com\/resources\/electronic-visit-verification-evv-for-billing-florida-medicaid-webinar\/","title":{"rendered":"Electronic Visit Verification (EVV) for Billing Florida Medicaid"},"content":{"rendered":"\n<div id=\"videoDivHolder\"> <div> <video controls poster=\"https:\/\/www.rethinkbehavioralhealth.com\/wp-content\/uploads\/2024\/10\/485-MTAzODk4Ng_evv-rethink-providers-billing-florida-medicaid_thumbnail.jpg\"> <source src=\"https:\/\/rtaprodmarketing.blob.core.windows.net\/rta-prod-marketingvideos\/485-MTAzODk4Ng_evv-rethink-providers-billing-florida-medicaid.mp4\" type=\"video\/mp4\"> <\/video> <\/div> <\/div> <style> #videoDivHolder { width: 100%; max-width: 900px; margin: 0 auto; } #videoDivHolder > div { position: relative; overflow: hidden; width: 100%; padding-top: 56.25%; } #videoDivHolder > div video { position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%; } <\/style>\n\n\n<h2>Electronic Visit Verification (EVV) for Rethink Providers billing Florida Medicaid (Regions 9, 10 and 11)<\/h2>\n<p>In preparation to go live with EVV, please join Rethink\u2019s <a href=\"https:\/\/www.rethinkbehavioralhealth.com\/our-solutions\/practice-management\/\">Electronic Visit Verification<\/a> via <a href=\"https:\/\/www.rethinkbehavioralhealth.com\/news-events\/rethink-behavioral-health-announces-strategic-partnership-with-tellus-evv-system\/\">Tellus<\/a> webinar to learn about Rethink\u2019s EVV capabilities to capture, submit and track claim statuses when billing Florida Medicaid (ACHA BA).<\/p>\n<p>This webinar is aimed to help inform, educate, and train BA providers as we move forward together with EVV and state mandatory compliance.<\/p>\n<p>Not sure what EVV is &amp; why is it important? <a href=\"https:\/\/www.rethinkbehavioralhealth.com\/resources\/what-is-electronic-visit-verification-evv-why-is-it-important\/\">Check out our EVV article here<\/a>.<\/p>","protected":false},"author":19,"featured_media":14482,"template":"","meta":{"_seopress_robots_primary_cat":"","_seopress_titles_title":"Webinar: EVV for Billing Florida Medicaid","_seopress_titles_desc":"In preparation to go live with EVV, learn about Rethink\u2019s capabilities to capture, submit and track claim statuses when billing Florida Medicaid (ACHA BA).","_seopress_robots_index":"","om_disable_all_campaigns":false,"_links_to":"","_links_to_target":""},"audience":[70],"resource-type":[72],"resource-topic":[83,335,86],"resource-tag":[317,376,375,377],"class_list":["post-9164","resources","type-resources","status-publish","has-post-thumbnail","hentry","audience-providers","resource-type-webinar","resource-topic-industry-news","resource-topic-practice-management","resource-topic-tips-tools-tech","resource-tag-compliance","resource-tag-evv","resource-tag-florida","resource-tag-medicaid"],"_links":{"self":[{"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/resources\/9164","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/resources"}],"about":[{"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/types\/resources"}],"author":[{"embeddable":true,"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/users\/19"}],"version-history":[{"count":0,"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/resources\/9164\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/media\/14482"}],"wp:attachment":[{"href":"https:\/\/w