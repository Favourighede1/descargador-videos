widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"46\" height=\"45\" src=\"https:\/\/www.rethinkbehavioralhealth.com\/wp-content\/uploads\/2023\/09\/mark-logo.svg\" class=\"attachment-large size-large wp-image-16877\" alt=\"white version of the RethinkBH circle logo mark\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3d65dcba elementor-widget elementor-widget-heading\" data-id=\"3d65dcba\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">Request a Demo Now to See What RethinkBH Can Do for Your ABA Practice<\/h4>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a148a6d elementor-widget elementor-widget-template\" data-id=\"a148a6d\" data-element_type=\"widget\" data-widget_type=\"template.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-template\">\n\t\t\t\t\t<div data-elementor-type=\"section\" data-elementor-id=\"16882\" class=\"elementor elementor-16882\" data-elementor-post-type=\"elementor_library\">\n\t\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-40ce024 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"40ce024\" data-element_type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-fb55561\" data-id=\"fb55561\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-7911d0e elementor-widget elementor-widget-html\" data-id=\"7911d0e\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- Version 4 does not show email error message when Zerobounce can not validate, but does disable being able to submit the form\r\nHubSpot\r\nZeroBounce\r\nLeanData\r\nCSS\r\n -->\r\n<!-- LeanData BookIt code -->\r\n<script>\r\n  function trySettingFormTarget(form) {\r\n    if (window['LDBookItV2'] && window['LDBookItV2'].setFormTarget) {\r\n      LDBookItV2.setFormTarget(form && form.id ? form : (form && form[0] ? form[0] : form));\r\n    } else {\r\n      window.setTimeout(() => trySettingFormTarget(form), 2000);\r\n    }\r\n  }\r\n\r\n  (function loadLeanData() {\r\n    var _ld_scriptEl = document.createElement('script');\r\n    _ld_scriptEl.src = 'https:\/\/cdn.leandata.com\/js-snippet\/ld-book-v2.js';\r\n    _ld_scriptEl.addEventListener('load', function () {\r\n      LDBookItV2.initialize('00Do0000000bYp9EAE', 'bh demo request', 'ld_bookit_log_id', {\r\n        autoSubmit: true,\r\n        popupModalCloseURL: 'https:\/\/www.rethinkbehavioralhealth.com\/request-a-demo\/form-confirmation-demo\/'\r\n      });\r\n      LDBookItV2.setFormProvider('hubspot_embed');\r\n    });\r\n    document.body.appendChild(_ld_scriptEl);\r\n  })();\r\n<\/script>\r\n\r\n<!-- HubSpot -->\r\n<script charset=\"utf-8\" type=\"text\/javascript\" src=\"https:\/\/js.hsforms.net\/forms\/embed\/v2.js\"><\/script>\r\n<div id=\"hubspot-form-request-demo\"><\/div>\r\n<script>\r\n  (function () {\r\n    \/\/ guard: ensure HubSpot is loaded\r\n    if (!window.hbspt || !hbspt.forms || !hbspt.forms.create) return;\r\n\r\n    hbspt.forms.create({\r\n      portalId: '2900416',\r\n      formId: '5fa08bca-5b6e-4548-aaf3-014844e81928',\r\n      target: '#hubspot-form-request-demo',   \/\/ optional but explicit\r\n      sfdcCampaignId: '7015c000001aFE8AAM',\r\n      css: '',\r\n      cssClass: 'hubSpotForm',\r\n\r\n      \/\/ single onFormReady that does BOTH: ZeroBounce + LeanData\r\n      onFormReady: function ($form) {\r\n        \/\/ --- ZeroBounce ---\r\n        const zbConfig = {\r\n          apiKey: '1b894e1494304a2388b38304a6e91615', \/\/ your public API key\r\n          disableSubmitOnError: true,\r\n          hubspotFormId: '5fa08bca-5b6e-4548-aaf3-014844e81928'\r\n        };\r\n\r\n        function initZeroBounce() {\r\n          if (typeof initializeZeroBounce === 'function') {\r\n            try { initializeZeroBounce(zbConfig); } catch (e) { console.error('ZeroBounce init error:', e); }\r\n          } else {\r\n            console.error('initializeZeroBounce function not found.');\r\n          }\r\n        }\r\n\r\n        if (!window.__zbWidgetLoaded) {\r\n          const script = document.createElement('script');\r\n          script.src = 'https:\/\/www.zerobounce.net\/widget\/ZeroBounceHubSpotValidationWidget.js';\r\n          script.async = true;\r\n          script.onload = function () {\r\n            window.__zbWidgetLoaded = true;\r\n            initZeroBounce();\r\n          };\r\n          document.head.appendChild(script);\r\n        } else {\r\n          initZeroBounce();\r\n        }\r\n\r\n  \/\/ --- CUSTOM: ZeroBounce Error Message Handling ---\r\n        const emailFieldWrapper = $form.find('.hs-email');\r\n        const emailInput = emailFieldWrapper.find('input[type=\"email\"]');\r\n        const errorMessageId = 'zb-error-message';\r\n        const errorHtml = `<span id=\"${errorMessageId}\" style=\"color: red; font-size: 12px; margin-top: 5px; display: none;\">Please enter a valid email address.<\/span>`;\r\n\r\n        \/\/ Add the error message element to the DOM if it doesn't already exist\r\n        if (emailFieldWrapper.length && !document.getElementById(errorMessageId)) {\r\n          emailFieldWrapper.append(errorHtml);\r\n        }\r\n        \r\n        const errorMessageElement = document.getElementById(errorMessageId);\r\n\r\n        \/\/ Listen for ZeroBounce validation events\r\n        document.addEventListener('ZeroBounceValidation', function (event) {\r\n          const status = event.detail.status;\r\n          if (status !== 'valid' && status !== 'accept_all' && status !== 'unknown') {\r\n            \/\/ Show the error message for invalid emails\r\n            errorMessageElement.style.display = 'block';\r\n          } else {\r\n            \/\/ Hide the error message for valid or acceptable emails\r\n            errorMessageElement.style.display = 'none';\r\n          }\r\n        });\r\n\r\n        \/\/ Hide the error message when the user starts typing again\r\n        emailInput.on('input', function() {\r\n            if (errorMessageElement) {\r\n                errorMessageElement.style.display = 'none';\r\n            }\r\n        });\r\n        \r\n        \/\/ --- LeanData target binding ---\r\n        trySettingFormTarget($form && $form[0] ? $form[0] : $form);\r\n      }\r\n    });\r\n  })();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Unlock Your Practice&#8217;s Full Potential with Trusted Integrations RethinkBH Marketplace offers a range of integrated, plug-and-play solutions Request A Demo As an ABA practice owner, whether you&#8217;re an established leader, in a growth phase, or just starting out, it is important that your technology adapts to your unique and evolving needs. Rethink&#8217;s Marketplace is a [&hellip;]<\/p>\n","protected":false},"author":51,"featured_media":20365,"parent":1121,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"",