ainer .hs-form-booleancheckbox label {\r\n margin-bottom: 0px;\r\n}\r\n\r\n.elementor-location-single #inContentHubSpotForm .hbspt-form .hs_submit.hs-submit,\r\n#inContentHubSpotForm .sd-post-details .hubSpotForm div.hs_error_rollup > ul,\r\n#inContentHubSpotForm .single-resources .hubSpotForm .hs_error_rollup {\r\n text-align: center;\r\n}\r\n\r\n.elementor-location-single #inContentHubSpotForm .hbspt-form .hs-error-msgs.inputs-list {\r\n padding-left: 0;\r\n margin-top: 5px;\r\n}\r\n\r\n.elementor-location-single #inContentHubSpotForm .hbspt-form .hs-error-msgs.inputs-list,\r\n.elementor-location-single #inContentHubSpotForm .hbspt-form fieldset div ul li,\r\n.elementor-location-single #inContentHubSpotForm .hubSpotForm .legal-consent-container li {\r\n list-style-type: none;\r\n}\r\n\r\n.elementor-location-single #inContentHubSpotForm .hbspt-form fieldset div div div div div ul.inputs-list {\r\n padding-left: 0;\r\n}\r\n\r\n#inContentHubSpotForm div > div.actions > input:hover,\r\n#inContentHubSpotForm .hubSpotForm .field.hs-form-field label span,\r\n#inContentHubSpotForm .hubSpotForm div.legal-consent-container > div.hs-richtext > p {\r\n color: var(--e-global-color-dc10a8f);\r\n}\r\n\r\n#inContentHubSpotForm .hubSpotForm input[type=submit] {\r\n    color: var(--e-global-color-d7be9cd);\r\n\tborder-color: var(--e-global-color-d7be9cd);\r\n}\r\n\r\n#inContentHubSpotForm .hubSpotForm input[type=submit]:hover {\r\n    color: white;\r\n    background-color: var(--e-global-color-d7be9cd);\r\n}\r\n\r\n#inContentHubSpotForm .hbspt-form .submitted-message {\r\n\ttext-align: center;\r\n\tfont-weight: bold;\r\n}\r\n\r\n<\/style>\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-7adc27b elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"7adc27b\" data-element_type=\"sec