eout(() => trySettingFormTarget(form), 2000);\r\n    }\r\n  }\r\n\r\n  (function loadLeanData() {\r\n    var _ld_scriptEl = document.createElement('script');\r\n    _ld_scriptEl.src = 'https:\/\/cdn.leandata.com\/js-snippet\/ld-book-v2.js';\r\n    _ld_scriptEl.addEventListener('load', function () {\r\n      LDBookItV2.initialize('00Do0000000bYp9EAE', 'bh demo request', 'ld_bookit_log_id', {\r\n        autoSubmit: true,\r\n        popupModalCloseURL: 'https:\/\/www.rethinkbehavioralhealth.com\/request-a-demo\/form-confirmation-demo\/'\r\n      });\r\n      LDBookItV2.setFormProvider('hubspot_embed');\r\n    });\r\n    document.body.appendChild(_ld_scriptEl);\r\n  })();\r\n<\/script>\r\n\r\n<!-- HubSpot -->\r\n<script charset=\"utf-8\" type=\"text\/javascript\" src=\"https:\/\/js.hsforms.net\/forms\/embed\/v2.js\"><\/script>\r\n<div id=\"hubspot-form-request-demo\"><\/div>\r\n<script>\r\n  (function () {\r\n    \/\/ guard: ensure HubSpot is loaded\r\n    if (!window.hbspt || !hbspt.forms || !hbspt.forms.create) return;\r\n\r\n    hbspt.forms.create({\r\n      portalId: '2900416',\r\n      formId: '5fa08bca-5b6e-4548-aaf3-014844e81928',\r\n      target: '#hubspot-form-request-demo',   \/\/ optional but explicit\r\n      sfdcCampaignId: '7015c000001aFE8AAM',\r\n      css: '',\r\n      cssClass: 'hubSpotForm',\r\n\r\n      \/\/ single onFormReady that does BOTH: ZeroBounce + LeanData\r\n      onFormReady: function ($form) {\r\n        \/\/ --- ZeroBounce ---\r\n        const zbConfig = {\r\n          apiKey: '1b894e1494304a2388b38304a6e91615', \/\/ your public API key\r\n          disableSubmitOnError: true,\r\n          hubspotFormId: '5fa08bca-5b6e-4548-aaf3-014844e81928'\r\n        };\r\n\r\n        function initZeroBounce() {\r\n          if (typeof initializeZeroBounce === 'function') {\r\n            try { initializeZeroBounce(zbConfig); } catch (e) { console.error('ZeroBounce init error:', e); }\r\n          } else {\r\n            console.error('initializeZeroBounce function not found.');\r\n          }\r\n        }\r\n\r\n        if (!window.__zbWidgetLoaded) {\r\n          const script = document.createElement('script');\r\n          script.src = 'https:\/\/www.zerobounce.net\/widget\/ZeroBounceHubSpotValidationWidget.js';\r\n          script.async = true;\r\n          script.onload = function () {\r\n            window.__zbWidgetLoaded = true;\r\n            initZeroBounce();\r\n          };\r\n          document.head.appendChild(script);\r\n        } else {\r\n          initZeroBounce();\r\n        }\r\n\r\n  \/\/ --- CUSTOM: ZeroBounce Error Message Handling ---\r\n        const emailFieldWrapper = $form.find('.hs-email');\r\n        const emailInput = emailFieldWrapper.find('input[type=\"email\"]');\r\n        const errorMessageId = 'zb-error-message';\r\n        const errorHtml = `<span id=\"${errorMessageId}\" style=\"color: red; font-size: 12px; margin-top: 5px; display: none;\">Please enter a valid email address.<\/span>`;\r\n\r\n        \/\/ Add the error message element to the DOM if it doesn't already exist\r\n        if (emailFieldWrapper.length && !document.getElementById(errorMessageId)) {\r\n          emailFieldWrapper.append(errorHtml);\r\n        }\r\n        \r\n        const errorMessageElement = document.getElementById(errorMessageId);\r\n\r\n        \/\/ Listen for ZeroBounce validation events\r\n        document.addEventListener('ZeroBounceValidation', function (event) {\r\n          const status = event.detail.status;\r\n          if (status !== 'valid' && status !== 'accept_all' && status !== 'unknown') {\r\n            \/\/ Show the error message for invalid emails\r\n            errorMessageElement.style.display = 'block';\r\n          } else {\r\n            \/\/ Hide the error message for valid or acceptable emails\r\n            errorMessageElement.style.display = 'none';\r\n          }\r\n        });\r\n\r\n        \/\/ Hide the error message when the user starts typing again\r\n        emailInput.on('input', function() {\r\n            if (errorMessageElement) {\r\n                errorMessageElement.style.display = 'none';\r\n            }\r\n        });\r\n        \r\n        \/\/ --- LeanData target binding ---\r\n        trySettingFormTarget($form && $form[0] ? $form[0] : $form);\r\n      }\r\n    });\r\n  })();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>ABA Therapy Billing and Insurance Services At RethinkBH, we offer easy, friendly pediatric therapy insurance billing services. Our goal is to help save your practice time and money by increasing efficiency. Request A Demo RethinkBH specializes in Revenue Cycle Management for Applied Behavior Analysis, Speech Therapy, Occupational Therapy, Physical Therapy, Counseling, Psychotherapy and Neuropsychology services. [&hellip;]<\/p>\n","protected":false},"author":51,"featured_media":15056,"parent":1121,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_seopress_robots_primary_cat":"","_seopress_titles_title":"Billing and Insurance Services for ABA Therapy","_seopress_titles_desc":"We provide ABA therapy billing services to maximize revenue for your ABA therapy practice. We support in & out-of-network practices in all states.","_seopress_robots_index":"","om_disable_all_campaigns":false,"footnotes":"","_links_to":"","_links_to_target":""},"class_list":["post-10766","page","type-page","status-publish","has-post-thumbnail","hentry"],"_links":{"self":[{"href":"https:\/\/www.rethinkbehavioralhealth.com\/wp-json\/wp\/v2\/pages\/10766","targetHints":{"allow":["GE