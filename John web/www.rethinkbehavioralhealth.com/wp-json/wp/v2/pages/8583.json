ss=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"#\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"17\" height=\"16\" viewBox=\"0 0 17 16\" fill=\"none\"><path d=\"M2.82806 7.24935C2.41385 7.24935 2.07806 7.58514 2.07806 7.99935C2.07806 8.41356 2.41385 8.74935 2.82806 8.74935L2.82806 7.24935ZM13.4947 8.74935C13.9089 8.74935 14.2447 8.41356 14.2447 7.99935C14.2447 7.58514 13.9089 7.24935 13.4947 7.24935V8.74935ZM11.356 4.13332C11.0618 3.84174 10.587 3.84386 10.2954 4.13806C10.0038 4.43225 10.0059 4.90712 10.3001 5.19871L11.356 4.13332ZM12.0034 5.83089L11.4754 6.36358L12.0034 5.83089ZM12.0034 10.1678L12.5313 10.7005L12.0034 10.1678ZM10.3001 10.8C10.0059 11.0916 10.0038 11.5664 10.2954 11.8606C10.587 12.1548 11.0618 12.157 11.356 11.8654L10.3001 10.8ZM13.4815 7.79046L14.2255 7.69563L14.2255 7.69563L13.4815 7.79046ZM13.4815 8.20824L14.2255 8.30307V8.30307L13.4815 8.20824ZM2.82806 8.74935L13.4947 8.74935V7.24935L2.82806 7.24935L2.82806 8.74935ZM10.3001 5.19871L11.4754 6.36358L12.5313 5.2982L11.356 4.13332L10.3001 5.19871ZM11.4754 9.63512L10.3001 10.8L11.356 11.8654L12.5313 10.7005L11.4754 9.63512ZM11.4754 6.36358C11.9566 6.84048 12.2716 7.15434 12.4821 7.41636C12.683 7.66655 12.7261 7.79574 12.7375 7.88529L14.2255 7.69563C14.1647 7.21905 13.9374 6.83294 13.6516 6.47711C13.3754 6.13312 12.9875 5.75026 12.5313 5.2982L11.4754 6.36358ZM12.5313 10.7005C12.9875 10.2484 13.3754 9.86557 13.6516 9.52158C13.9374 9.16576 14.1647 8.77965 14.2255 8.30307L12.7375 8.11341C12.7261 8.20296 12.683 8.33215 12.4821 8.58234C12.2716 8.84436 11.9566 9.15822 11.4754 9.63512L12.5313 10.7005ZM12.7375 7.88529C12.7471 7.96103 12.7471 8.03767 12.7375 8.11341L14.2255 8.30307C14.2512 8.10139 14.2512 7.8973 14.2255 7.69563L12.7375 7.88529Z\" fill=\"currentColor\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Chat With Us Live<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5864480 elementor-widget elementor-widget-text-editor\" data-id=\"5864480\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Chat Support hours: Monday-Friday, 9:00 AM to 5:00 PM Eastern.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-224069e elementor-widget elementor-widget-html\" data-id=\"224069e\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- Version 6 part 1 of 2 - July 30, 2025 added hide sf support if it is after work hours\r\nCode location: Support page\r\n\u2022 works: shows Salesforce chat by default in bottom right\r\n\u2022 works: opens chat when \"Chat With Us Live\" button link is clicked\r\n\u2022 works: starts chat\r\n -->\r\n<script>\r\n\/\/ Function to check if current time is within business hours (9am-5pm Eastern Time)\r\n(function() {\r\n    function isBusinessHour() {\r\n        const now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"America\/New_York\"}));\r\n        const day = now.getDay(); \/\/ 0 (Sunday) to 6 (Saturday)\r\n        const hour = now.getHours();\r\n        const minute = now.getMinutes(); \/\/ Get minutes\r\n        \/\/ UTC time is 4 hours ahead of EST\r\n        const businessHoursBegin = 9;\r\n        const businessHoursEnd = 17;\r\n        const businessDaysBegin = 1;\r\n        const businessDaysEnd = 5;\r\n\r\n        return (day >= businessDaysBegin && day <= businessDaysEnd\r\n            && hour >= businessHoursBegin && hour < businessHoursEnd\r\n            && (hour !== businessHoursEnd || minute < 60)) \/\/ Include 5pm if minute is less than 60\r\n            && !(now.getMonth() === 7 && now.getDate() === 4); \/\/ Exclude July 4th\r\n    }\r\n\r\n    \/\/ Get the element containing the chat button icon\r\n    const chatButtonContainer = document.querySelector(\"#sfdc-live-chat .elementor-button-icon.elementor-align-icon-right\");\r\n    const chatButtonText = document.querySelector(\"#sfdc-live-chat > div > div > a > span > span.elementor-button-text\");\r\n\r\n    \/\/ Update chat button based on business hours\r\n    function updateChatButton() {\r\n        if (!isBusinessHour()) {\r\n            \/\/ Outside business hours, replace svg, disable click event, and change text color\r\n            \/\/ Create a dedicated CSS class for hover\/focus styles\r\n            const hoverFocusStyle = document.createElement(\"style\");\r\n            hoverFocusStyle.textContent = ' #sfdc-live-chat > div > div > a, #sfdc-live-chat > div > div > a:hover, #sfdc-live-chat > div > div > a:focus {  color: #636363 !important;  pointer-events: none; } #sfdc-live-chat > div > div > a > span > span.elementor-button-icon.elementor-align-icon-right {   margin-top: 0px;} .embeddedMessagingConversationButton { display: none !important} ';\r\n            document.head.appendChild(hoverFocusStyle);\r\n            chatButtonText.innerHTML = \"Chat With Us Live (Offline)\";\r\n            const chatButtonLink = chatButtonContainer.parentElement.querySelector(\"a\");\r\n            chatButtonLink && chatButtonLink.removeEventListener(\"click\", function () {\r\n            });\r\n            if (chatButtonLink) {\r\n                chatButtonLink.style.color = \"#636363 !important\";\r\n            }\r\n            \/\/ Modify hover\/focus colors\r\n            const buttonHoverFocus = document.querySelectorAll(\".elementor-8583 .elementor-element.elementor-element-2b7a7ac9 .elementor-button:hover, .elementor-8583 .elementor-element.elementor-element-2b7a7ac9 .elementor-button:focus\");\r\n            buttonHoverFocus.forEach(button => button.style.color = '#636363 !important');\r\n\r\n            \/\/ Add \"(Offline)\" to the button text\r\n            if (chatButtonText) {\r\n                chatButtonText.textContent = chatButtonText.textContent + \" (Offline)\";\r\n            }\r\n\r\n        } else {\r\n            \/\/ During business hours, keep the original content (no need to modify)\r\n            const chatButton = document.getElementById('sfdc-live-chat');\r\n            chatButton.addEventListener('click', function (e) {\r\n                embeddedservice_bootstrap.utilAPI.launchChat();\r\n            });\r\n            \/\/remove (offline) from button text if it exists.\r\n            if(chatButtonText && chatButtonText.textContent.includes(\" (Offline)\")) {\r\n                chatButtonText.textContent = chatButtonText.textContent.replace(\" (Offline)\", \"\");\r\n            }\r\n        }\r\n    }\r\n\r\n    \/\/ Call the update function initially\r\n    updateChatButton();\r\n}());\r\n\/\/ No need for regular updates as the modification only happens outside business hours\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-0b54026 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"0b54026\" data-element_type=\"section\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-30914ea\" data-id=\"30914ea\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-5b9a31b5 elementor-widget__width-auto elementor-widget elementor-widget-image\" data-id=\"5b9a31b